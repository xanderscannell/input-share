{
  "productName": "input-share",
  "version": "0.2.0",
  "identifier": "dev.inputshare.gui",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "input-share", "width": 440, "height": 600, "minWidth": 380, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
